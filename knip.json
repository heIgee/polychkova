{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "app/**/page.tsx",
    "app/**/layout.tsx",
    "app/**/route.ts",
    "app/**/opengraph-image.tsx",
    "lib/**/*.ts",
    "!lib/**/*.test.ts",
    "auth.ts"
  ],
  "project": [
    "app/**/*.tsx",
    "app/**/*.ts",
    "app/**/*.css",
    "components/**/*.ts",
    "components/**/*.tsx",
    "lib/**/*.ts",
    "scripts/**/*.mjs"
  ],
  "ignoreExportsUsedInFile": true
}
