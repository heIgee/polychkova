# Copy to .env.local. Next.js loads that file. pnpm db:migrate reads it when DIRECT_URL is not already set.

DATABASE_URL=
DIRECT_URL=
AUTH_SECRET=
AUTH_URL=http://localhost:3100
# true on a public host so Auth.js trusts the request host. Leave unset locally.
AUTH_TRUST_HOST=
AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Optional Twitch application used as IGDB credentials for game search.
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
