{
  "name": "polychkova",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@10.12.4",
  "scripts": {
    "prepare": "lefthook install",
    "typecheck": "tsc --noEmit",
    "check": "pnpm lint && pnpm typecheck",
    "verify": "pnpm check && pnpm test:coverage && pnpm knip",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "knip": "knip"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.1",
    "@types/node": "^26.3.0",
    "@vitest/coverage-v8": "^4.1.10",
    "knip": "^6.23.0",
    "lefthook": "^2.1.9",
    "typescript": "^5.9.2",
    "vitest": "^4.1.10"
  }
}
