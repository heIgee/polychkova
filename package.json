{
  "name": "polychkova",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@10.12.4",
  "scripts": {
    "prepare": "lefthook install",
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "next start -p 3100",
    "typecheck": "tsc --noEmit",
    "check": "pnpm lint && pnpm typecheck",
    "verify": "pnpm check && pnpm test:coverage && pnpm knip && pnpm build",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "knip": "knip",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/db-migrate.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.3.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitest/coverage-v8": "^4.1.10",
    "drizzle-kit": "^0.31.11",
    "knip": "^6.23.0",
    "lefthook": "^2.1.9",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.2",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "^1.11.3",
    "drizzle-orm": "^0.45.4",
    "next": "^16.3.3",
    "next-auth": "5.0.0-beta.32",
    "postgres": "^3.4.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-easy-crop": "^6.2.4"
  }
}
